# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=sermon_engine
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sermon_engine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sermon_engine:change_me@postgres:5432/sermon_engine
# Synchronous URL, used by Alembic (asyncpg migrations are more trouble than they're worth).
DATABASE_URL_SYNC=postgresql+psycopg2://sermon_engine:change_me@postgres:5432/sermon_engine

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Clerk (auth) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- App ---
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# Server-side only (no NEXT_PUBLIC_ prefix) — the backend is reachable over
# the internal Docker network, not from the browser. See docker-compose.yml.
BACKEND_INTERNAL_URL=http://backend:8000
