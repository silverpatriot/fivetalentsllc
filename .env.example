# Copy to .env and fill in real values. Never commit .env.

# --- Postgres ---
# Admin/superuser bootstrap role. Used ONLY for migrations (DATABASE_URL_SYNC,
# computed in app/core/config.py — not set directly here) — the official
# postgres image makes this a superuser, and superusers bypass row-level
# security unconditionally. Never point app runtime traffic at this role,
# or RLS silently does nothing.
POSTGRES_USER=sermon_engine_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sermon_engine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Non-superuser role the app/celery-worker/tests actually connect as
# (DATABASE_URL, also computed, not set directly). Created by
# postgres/init/01-create-app-role.sh with this exact name and password,
# then granted DML-only privileges by migration 0002 — which reads this
# same APP_DB_USER value rather than a hardcoded name, so the role the
# init script creates and the role the migration grants to can't drift
# apart. This is what RLS actually applies to.
APP_DB_USER=sermon_engine_app
APP_DB_PASSWORD=change_me_too

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Clerk (auth) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# From the Clerk Dashboard's webhook endpoint config (Webhooks > your
# endpoint > Signing Secret), NOT the same as CLERK_SECRET_KEY. Set the
# endpoint URL there to https://<your-domain>/api/webhooks/clerk (the
# Next.js proxy — see frontend/app/api/webhooks/clerk/route.ts).
CLERK_WEBHOOK_SECRET=

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=
# From the Stripe Dashboard's webhook endpoint config. Endpoint URL:
# https://<your-domain>/api/webhooks/stripe (the Next.js proxy — see
# frontend/app/api/webhooks/stripe/route.ts).
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Populated by running `python backend/scripts/stripe_setup.py` against a
# real (test-mode first) Stripe account — see that script and Task 2 in
# the Phase 2 spec. Blank/placeholder until then; billing/checkout is
# non-functional without these.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_METER_TRANSCRIPTION_MINUTES=transcription_minutes
STRIPE_PRICE_TRANSCRIPTION_MINUTES=
STRIPE_METER_AI_GENERATIONS=ai_generations
STRIPE_PRICE_AI_GENERATIONS=

# --- App ---
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# Server-side only (no NEXT_PUBLIC_ prefix) — the backend is reachable over
# the internal Docker network, not from the browser. See docker-compose.yml.
BACKEND_INTERNAL_URL=http://backend:8000
# Publicly reachable frontend URL — used to build Stripe Checkout/Portal
# redirect URLs. The browser's own address for the app, not the internal
# one above.
FRONTEND_URL=http://localhost:3000
